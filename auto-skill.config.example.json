{
  "version": "4.2.0",
  "description": "Auto-Skill configuration template. Update paths for your environment.",

  "pathTemplates": {
    "D":  "{global_skills}/{id}/SKILL.md",
    "C":  "{claude_skills}/{id}/SKILL.md",
    "AS": "{auto_skill}/skills/{id}/SKILL.md"
  },

  "platforms": {
    "win32": {
      "auto_skill":     "C:/Users/{USERNAME}/.gemini/antigravity/global_skills/auto-skill",
      "global_skills":  "C:/Users/{USERNAME}/.gemini/antigravity/global_skills",
      "claude_skills":  "C:/Users/{USERNAME}/.claude/skills"
    },
    "darwin": {
      "auto_skill":     "~/.gemini/antigravity/global_skills/auto-skill",
      "global_skills":  "~/.gemini/antigravity/global_skills",
      "claude_skills":  "~/.claude/skills"
    },
    "linux": {
      "auto_skill":     "~/.gemini/antigravity/global_skills/auto-skill",
      "global_skills":  "~/.gemini/antigravity/global_skills",
      "claude_skills":  "~/.claude/skills"
    }
  },

  "specialPaths": {
    "vault": "{USER_HOME}/note",
    "diary": "{vault}/10_Daily"
  },

  "experienceRouting": {
    "_comment": "Optional. Graduate a skill here once it has BOTH its own project root AND a loop that keeps producing cases. Full cases then live in the project's case-ledger, and the global experience file becomes a map. Delete this block if unused.",

    "<your-skill-id>": {
      "mode": "project-ledger",
      "caseLedger":     "<project-root>/references/case-ledger.md",
      "governance":     "<project-root>/references/experience-governance.md",
      "legacyArchive":  "<project-root>/references/legacy-experience-full.md",
      "globalInterface": "{auto_skill}/experience/skill-<your-skill-id>.md",
      "writeFullCaseToGlobal": false,
      "globalInterfaceBaselineSha256": "<sha256 of the rewritten global map — lets a validator detect silent overwrites>"
    }
  },

  "mcpSkills": ["voicebox", "colab-mcp"],

  "notes": {
    "{USERNAME}": "Automatically detected from OS environment",
    "{USER_HOME}": "Automatically detected from OS environment",
    "Setup": "1. Rename this to auto-skill.config.json. 2. Update paths. 3. Run setup."
  }
}
